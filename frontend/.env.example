NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_MODE=development
NEXT_PUBLIC_DEMO_ORGANIZATION_ID=
NEXT_PUBLIC_DEMO_EMAIL=demo@groundsops.ai
NEXT_PUBLIC_STORAGE_DIRECT_URLS=false
# For Cognito login, change AUTH_MODE and provide Terraform outputs:
# NEXT_PUBLIC_AUTH_MODE=cognito
# NEXT_PUBLIC_COGNITO_REGION=ca-central-1
# NEXT_PUBLIC_COGNITO_CLIENT_ID=<web_client_id>
# Enable after configuring private S3 storage and bucket CORS:
# NEXT_PUBLIC_STORAGE_DIRECT_URLS=true
# Show the "Create a company workspace" option on the sign-in screen (invite-only when false)
NEXT_PUBLIC_SELF_SERVICE_SIGNUP=false
