APP_ENV=development
DATABASE_URL=postgresql+psycopg://groundsops:groundsops@localhost:5432/groundsops
LOG_LEVEL=INFO
AUTH_MODE=development
DEMO_WORKSPACE_ENABLED=false
JWT_ISSUER=groundsops-local
JWT_AUDIENCE=groundsops-api
JWT_SECRET=replace-with-a-long-random-local-development-secret
JWT_TTL_MINUTES=60
STORAGE_BACKEND=local
STORAGE_ROOT=./var/uploads
STORAGE_SIGNED_URL_TTL_SECONDS=300
# Production private object storage:
# STORAGE_BACKEND=s3
# S3_BUCKET=groundsops-production-private
# S3_REGION=ca-central-1
# S3_ENDPOINT_URL=  # Optional for S3-compatible providers
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID= # Leave unset on AWS when using an IAM role
# S3_SECRET_ACCESS_KEY=
# S3_KMS_KEY_ID=    # Optional; otherwise S3 AES-256 encryption is used
# S3_SERVER_SIDE_ENCRYPTION=AES256 # Use none only if the provider rejects SSE headers
IMAGE_MAX_BYTES=10485760
IMAGE_MAX_PIXELS=25000000
INFERENCE_PROVIDER=disabled
INFERENCE_MONTHLY_BUDGET_USD=10
INFERENCE_ESTIMATED_JOB_COST_USD=0.10
REPLICATE_COST_PER_OUTPUT_USD=0.05
EVALUATION_MASKED_CHANGE_MIN=0.20
EVALUATION_PROTECTED_CHANGE_MAX=0.08
EVALUATION_PIXEL_CHANGE_THRESHOLD=0.05
# REPLICATE_API_TOKEN=never-commit-this-value
# Use an official model identifier or a pinned community-model version hash.
# REPLICATE_MODEL_VERSION=black-forest-labs/flux-fill-pro
# Optional: override only for a different trusted frontend origin.
# Include your public web domain and the Capacitor iOS origin in production.
# CORS_ORIGIN_REGEX=^(https://app\.example\.com|capacitor://localhost)$
# Production OIDC/Cognito value:
# OIDC_JWKS_URL=https://cognito-idp.ca-central-1.amazonaws.com/<pool>/.well-known/jwks.json
# JWT_ISSUER=https://cognito-idp.ca-central-1.amazonaws.com/<pool>
# JWT_AUDIENCE=<cognito-app-client-id>
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60
# Subscription billing (Stripe). Leave BILLING_ENABLED=false for demos and self-hosting.
BILLING_ENABLED=false
BILLING_TRIAL_DAYS=14
BILLING_PLAN_NAME=GroundsOps Pro
APP_PUBLIC_URL=http://localhost:3000
# STRIPE_SECRET_KEY=never-commit-this-value
# STRIPE_WEBHOOK_SECRET=never-commit-this-value
# STRIPE_PRICE_ID=price_...
# STRIPE_AUTOMATIC_TAX=false  # true only after Stripe Tax is configured
# New company workspaces are created by platform admins and invitations. Set true to allow open sign-up.
SELF_SERVICE_SIGNUP_ENABLED=false
