# Public demo server only. Never use these settings on staging or production:
# demo mode turns on development sign-in, which is only safe with demo data.
APP_DOMAIN=demo.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_ENV=demo
LOG_LEVEL=INFO
DEMO_WORKSPACE_ENABLED=true
AUTH_MODE=development
JWT_SECRET=replace-with-a-long-random-secret
INFERENCE_PROVIDER=mock
SELF_SERVICE_SIGNUP_ENABLED=false
BILLING_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60
# Private bucket created with: cd infra/storage; terraform workspace new demo; terraform apply -var "environment=demo"
STORAGE_BACKEND=s3
S3_BUCKET=replace-with-demo-bucket
S3_REGION=ca-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MALWARE_SCAN_ENABLED=true
MALWARE_SCAN_REQUIRED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Allow only the demo site to call the API.
CORS_ORIGIN_REGEX=^https://demo\.example\.com$
