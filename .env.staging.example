APP_DOMAIN=staging.example.com
AWS_REGION=ca-central-1
POSTGRES_PASSWORD=replace-with-a-long-random-password

APP_ENV=staging
LOG_LEVEL=INFO
AUTH_MODE=cognito
DEMO_WORKSPACE_ENABLED=false
JWT_ISSUER=https://cognito-idp.ca-central-1.amazonaws.com/replace-user-pool-id
JWT_AUDIENCE=replace-cognito-client-id
OIDC_JWKS_URL=https://cognito-idp.ca-central-1.amazonaws.com/replace-user-pool-id/.well-known/jwks.json
COGNITO_CLIENT_ID=replace-cognito-client-id
CORS_ORIGIN_REGEX="^(https://staging\.example\.com|capacitor://localhost)$"

STORAGE_BACKEND=s3
S3_BUCKET=replace-private-bucket-name
S3_REGION=ca-central-1
S3_ACCESS_KEY_ID=replace-scoped-access-key
S3_SECRET_ACCESS_KEY=replace-scoped-secret-key
S3_SERVER_SIDE_ENCRYPTION=AES256
STORAGE_SIGNED_URL_TTL_SECONDS=300

IMAGE_MAX_BYTES=10485760
IMAGE_MAX_PIXELS=25000000
VAULT_MAX_BYTES=26214400
VAULT_QUOTA_BYTES=1073741824
INFERENCE_PROVIDER=disabled
INFERENCE_MONTHLY_BUDGET_USD=10
# Enable only after storing the token in the server's uncommitted .env.staging file.
# REPLICATE_API_TOKEN=never-commit-this-value
# REPLICATE_MODEL_VERSION=black-forest-labs/flux-fill-pro
# REPLICATE_COST_PER_OUTPUT_USD=0.05

# Database backups use the same scoped credentials until the application moves
# to compute with an IAM role. Never commit this file.
BACKUP_S3_URI=s3://replace-private-bucket-name/database-backups
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=240
RATE_LIMIT_WINDOW_SECONDS=60

MALWARE_SCAN_ENABLED=true
MALWARE_SCAN_REQUIRED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
ALERT_WEBHOOK_URL=
# Subscription billing. Use Stripe test-mode keys (sk_test_...) on staging.
BILLING_ENABLED=false
BILLING_TRIAL_DAYS=14
BILLING_PLAN_NAME=GroundsOps Pro
APP_PUBLIC_URL=https://staging.example.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_AUTOMATIC_TAX=false
